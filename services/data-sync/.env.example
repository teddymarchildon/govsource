SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
CONGRESS_API_KEY=your-congress-gov-api-key
COURT_LISTENER_API_KEY=your-courtlistener-api-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_TOPIC_MODEL=gpt-5-nano
AI_CLASSIFICATION_LIMIT=100
AI_CLASSIFICATION_LOOKBACK_DAYS=90
AI_CLASSIFICATION_MAX_SOURCE_CHARS=12000
# Defaults respect CourtListener's standard 50/hour and 125/day API quotas.
COURT_LISTENER_MINIMUM_REQUEST_INTERVAL=72
COURT_LISTENER_MAX_API_REQUESTS=120
